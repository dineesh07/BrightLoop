// Prisma schema for Brightloop Subscription Management System
// Configured for Neon Serverless PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                    String         @id @default(uuid())
  email                 String         @unique
  name                  String
  passwordHash          String
  role                  String         @default("CUSTOMER") // ADMIN, STAFF, CUSTOMER
  companyName           String?
  phone                 String?
  address               String?
  city                  String?
  country               String?
  vatNumber             String?
  currency              String         @default("USD")
  resetPasswordToken    String?
  resetPasswordExpires  DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  subscriptions         Subscription[] @relation("CustomerSubscriptions")
  invoices              Invoice[]      @relation("CustomerInvoices")
  recordedPayments      Payment[]      @relation("RecordedPayments")

  @@index([role])
}

model Product {
  id                    String                  @id @default(uuid())
  name                  String
  type                  String                  @default("SOFTWARE") // SOFTWARE, SERVICE, ADDON, MODULE
  salesPrice            Float
  costPrice             Float                   @default(0.0)
  notes                 String?
  active                Boolean                 @default(true)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  variants              ProductVariant[]
  subscriptionLines     SubscriptionLine[]
  invoiceLines          InvoiceLine[]
  templateLines         QuotationTemplateLine[]
  discountRules         DiscountRule[]          @relation("ProductDiscounts")

  @@index([active])
}

model ProductVariant {
  id                String                  @id @default(uuid())
  productId         String
  name              String                  // e.g. "Odoo Edition", "Enterprise", "Pro"
  priceExtra        Float                   @default(0.0)
  active            Boolean                 @default(true)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  product           Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  subscriptionLines SubscriptionLine[]
  invoiceLines      InvoiceLine[]
  templateLines     QuotationTemplateLine[]

  @@index([productId])
}

model Plan {
  id                 String              @id @default(uuid())
  name               String
  code               String              @unique
  cost               Float
  billingInterval    String              @default("MONTHLY") // DAILY, WEEKLY, MONTHLY, YEARLY
  minQuantity        Int                 @default(1)
  availableStartDate DateTime?
  availableEndDate   DateTime?
  autoCloseOnEnd     Boolean             @default(false)
  allowEarlyClose    Boolean             @default(true)
  allowPause         Boolean             @default(true)
  allowRenewal       Boolean             @default(true)
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  subscriptions      Subscription[]
  quotationTemplates QuotationTemplate[]

  @@index([active])
  @@index([billingInterval])
}

model QuotationTemplate {
  id           String                  @id @default(uuid())
  name         String
  planId       String
  validityDays Int                     @default(14)
  notes        String?
  active       Boolean                 @default(true)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  plan         Plan                    @relation(fields: [planId], references: [id])
  lines        QuotationTemplateLine[]

  @@index([planId])
}

model QuotationTemplateLine {
  id                  String          @id @default(uuid())
  quotationTemplateId String
  productId           String
  productVariantId    String?
  quantity            Int             @default(1)
  unitPrice           Float

  quotationTemplate   QuotationTemplate @relation(fields: [quotationTemplateId], references: [id], onDelete: Cascade)
  product             Product           @relation(fields: [productId], references: [id])
  variant             ProductVariant?   @relation(fields: [productVariantId], references: [id])

  @@index([quotationTemplateId])
}

model TaxRule {
  id        String   @id @default(uuid())
  name      String   // e.g., "VAT 20%", "Sales Tax 8.25%"
  rate      Float    // percentage e.g., 20.0
  country   String?  // null or code like "US", "UK", "EU"
  isDefault Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isDefault])
  @@index([active])
}

model DiscountRule {
  id                 String         @id @default(uuid())
  code               String         @unique
  description        String
  discountType       String         @default("PERCENTAGE") // PERCENTAGE, FIXED_AMOUNT
  value              Float          // 10 for 10% or 50.0 for $50
  minPurchaseAmount  Float?
  minQuantity        Int?
  startDate          DateTime?
  endDate            DateTime?
  maxUsageLimit      Int?
  usageCount         Int            @default(0)
  scope              String         @default("ALL_SUBSCRIPTION") // ALL_SUBSCRIPTION, SPECIFIC_PRODUCT
  productId          String?
  active             Boolean        @default(true)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  product            Product?       @relation("ProductDiscounts", fields: [productId], references: [id])
  subscriptions      Subscription[]

  @@index([active])
  @@index([code])
}

model Subscription {
  id                 String             @id @default(uuid())
  subscriptionNumber String             @unique // e.g. "SUB-2026-0001"
  customerId         String
  planId             String
  status             String             @default("DRAFT") // DRAFT, QUOTATION, CONFIRMED, ACTIVE, PAUSED, CLOSED
  startDate          DateTime           @default(now())
  expiryDate         DateTime?
  nextBillingDate    DateTime
  paymentTerms       String             @default("Immediate") // Immediate, Net 15, Net 30, Net 60
  autoRenew          Boolean            @default(true)
  discountRuleId     String?
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  customer           User               @relation("CustomerSubscriptions", fields: [customerId], references: [id])
  plan               Plan               @relation(fields: [planId], references: [id])
  discountRule       DiscountRule?      @relation(fields: [discountRuleId], references: [id])
  lines              SubscriptionLine[]
  invoices           Invoice[]

  @@index([customerId])
  @@index([planId])
  @@index([status])
  @@index([nextBillingDate])
}

model SubscriptionLine {
  id               String          @id @default(uuid())
  subscriptionId   String
  productId        String
  productVariantId String?
  quantity         Int             @default(1)
  unitPrice        Float
  taxRate          Float           @default(0.0)
  notes            String?

  subscription     Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  product          Product         @relation(fields: [productId], references: [id])
  variant          ProductVariant? @relation(fields: [productVariantId], references: [id])

  @@index([subscriptionId])
}

model Invoice {
  id                 String        @id @default(uuid())
  invoiceNumber      String        @unique // e.g. "INV-2026-0001"
  customerId         String
  subscriptionId     String?
  status             String        @default("DRAFT") // DRAFT, CONFIRMED, PAID, CANCELLED
  issueDate          DateTime      @default(now())
  dueDate            DateTime
  subtotal           Float         @default(0.0)
  taxTotal           Float         @default(0.0)
  discountTotal      Float         @default(0.0)
  grandTotal         Float         @default(0.0)
  amountPaid         Float         @default(0.0)
  billingPeriodStart DateTime?
  billingPeriodEnd   DateTime?
  sentAt             DateTime?
  notes              String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  customer           User          @relation("CustomerInvoices", fields: [customerId], references: [id])
  subscription       Subscription? @relation(fields: [subscriptionId], references: [id])
  lines              InvoiceLine[]
  payments           Payment[]

  @@index([customerId])
  @@index([subscriptionId])
  @@index([status])
  @@index([dueDate])
}

model InvoiceLine {
  id               String          @id @default(uuid())
  invoiceId        String
  productId        String
  productVariantId String?
  description      String
  quantity         Int             @default(1)
  unitPrice        Float
  taxRate          Float           @default(0.0)
  taxAmount        Float           @default(0.0)
  discountAmount   Float           @default(0.0)
  lineTotal        Float

  invoice          Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product          Product         @relation(fields: [productId], references: [id])
  variant          ProductVariant? @relation(fields: [productVariantId], references: [id])

  @@index([invoiceId])
}

model Payment {
  id                   String   @id @default(uuid())
  invoiceId            String
  amount               Float
  paymentDate          DateTime @default(now())
  method               String   @default("CREDIT_CARD") // CREDIT_CARD, BANK_TRANSFER, STRIPE, CASH, CHECK, DIRECT_DEBIT
  transactionReference String
  notes                String?
  recordedById         String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  invoice              Invoice  @relation(fields: [invoiceId], references: [id])
  recordedBy           User     @relation("RecordedPayments", fields: [recordedById], references: [id])

  @@index([invoiceId])
  @@index([paymentDate])
}

model BillingLog {
  id                     String   @id @default(uuid())
  executedAt             DateTime @default(now())
  subscriptionsProcessed Int      @default(0)
  invoicesCreated        Int      @default(0)
  totalBilled            Float    @default(0.0)
  status                 String   @default("COMPLETED") // COMPLETED, FAILED
  logsJson               String?
}

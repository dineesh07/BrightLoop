# ==============================================================================
# Brightloop Software - Environment Configuration
# ==============================================================================

# Database Connection (Neon Serverless PostgreSQL)
# 1. DATABASE_URL: Connection pooling endpoint for regular application queries (pgbouncer)
DATABASE_URL="postgresql://[user]:[password]@[ep-xyz].us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# 2. DIRECT_URL: Direct unpooled endpoint for Prisma migrations, schema push, and CLI operations
DIRECT_URL="postgresql://[user]:[password]@[ep-xyz].us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT Authentication Secret (Used for role sessions and stateless verification)
JWT_SECRET="brightloop_super_secret_jwt_key_2026_subscription_system"

# Application Metadata
NEXT_PUBLIC_APP_NAME="Brightloop Software"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Nodemailer / SMTP Configuration
# Works seamlessly with Resend, SendGrid, Mailgun, Brevo, AWS SES, or custom SMTP servers
SMTP_HOST="smtp.resend.com"
SMTP_PORT="587"
SMTP_USER="resend"
SMTP_PASS="re_your_smtp_api_key_here"
SMTP_SECURE="false"
EMAIL_FROM="Brightloop Software <billing@brightloop.com>"
